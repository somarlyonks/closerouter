CloseRouter:
    core:
        [x] config loading & validation
    cli:
        [x] help
        server:
            [x] detach
            [x] config path
        [x] version
    server:
        [x] router
        [x] bind the HTTP listener to 127.0.0.1
        [x] auth by bearer key
        [x] proxy forwarding with SSE streaming
        routes:
            v1:
                [x] chat/completions
                [x] models
                [x] responses
            [x] config
            logs:
                [x] manual refresh against batched GET /logs results and deduplicate by database row/request ID
                [x] integration tests
            status:
                [x] server ok
                [x] server version
                [x] sqlite version when db configured
            usage:
                [x] filters
                [x] exclude 4xx client error responses
                [x] provider/model breakdown aggregation
                [x] heatmap daily buckets, sparse
    db:
        [x] SQLite ABI
        [x] sql interface functions
        [x] tests
        [x] config field
        [x] in momery
        [x] persistent
        [x] age-based retention
        [x] schema migrations
    test:
        [x] mock provider server
        [x] persistent test.db (test config db)
        [x] seed/backfill mock usage via mock server
    app:
        scaffold:
            [x] xcode project
            [x] bundle closerouter binary
            [x] icon
            [x] run script build wiring
            [x] fix zed language server
        process core:
            [x] ServerManager (spawn/monitor/restart)
            [x] menu bar start/stop + open window
            [x] default config in Application Support
        overview:
            [x] status banner
            [x] usage totals
            [x] provider/model list
            [x] health check via /status
            [x] notify when starting with occupied port
        config editor:
            [x] CodeTextView (NSTextView)
            [x] schema completions
            [x] validation + format
            [x] save via PUT /config
        logs:
            [x] manual GET /logs refresh that deduplicates rows
            [ ] filter/clear
            [x] history on open
        analytics:
            date range:
                [x] Day, Week, Month, Year presets
                [x] time range navigation
            provider/model filters:
                [x] model-then-provider
                [x] provider-then-model
                [x] the other selector's menu is constrained to compatible options
            [x] stat cards
            chart:
                [x] aggregate series to at most 45 buckets
                [x] line chart for requests
                histogram chart for tokens:
                    [x] split by model
                    [x] stable name-based model colors (sorted domain + fixed palette)
                    [x] tokens chart hover
                heatmap:
                    [x] render only when date range year selected
                    [x] implement with RectangleMark Chart (week x weekday, Monday on top)
                    [x] year grid labels: months on top + Mon/Wed/Fri + Less/More legend
                    [x] hover tooltip
            [x] breakdown lists
            [x] responsive layout
        settings:
            [x] launch at login (SMAppService)
            [x] notifications on crash/start
            [x] hide dock icon (accessory mode, menu bar + background server stay alive)
            [x] copy runtime key
            updates:
                [x] UpdateChecker (GitHub releases API, semver compare)
                [x] Settings > Updates section (Check Now, auto-check toggle, download link)
                [x] auto-check on launch via AppDelegate
